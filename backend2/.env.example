# Node.js / Express
PORT=3000
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/
DB_NAME=BestBefore_TestDB

# Firebase (service account values)
FIREBASE_PROJECT_ID=your_project_id
FIREBASE_PRIVATE_KEY=your_private_key
FIREBASE_CLIENT_EMAIL=your_client_email

# AI Microservice (Python FastAPI on port 8000)
AI_SERVICE_URL=http://localhost:8000
OPENAI_API_KEY=sk-...   # Required for ai_service — keep out of git

# Preference learning (set to true to enable AI profile updates)
ENABLE_PREFERENCE_TRACKING=true

# Frontend (for CORS if needed)
FRONTEND_URL=http://localhost:3000
